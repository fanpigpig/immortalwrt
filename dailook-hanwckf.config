#
# netcore_n60pro 512rom 专用
# 512MB NAND Flash 专用，不可用于128MB版本
#
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_netcore_n60pro-512rom=y
# base device last accepted as of 2026-01-20 (subject to local tree patches for MT7986 NAND layout)
# CONFIG_TARGET_mediatek_filogic_DEVICE_netcore_n60pro is not set
CONFIG_TARGET_ALL_PROFILES=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=200
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_KERNEL_BUILD_USER="dailook"
CONFIG_KERNEL_BUILD_DOMAIN="hanwckf"
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_LIBC="musl"
CONFIG_IPv6=y
CONFIG_COLLAPSE_MENU=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_LAST_STABLE=y
CONFIG_PACKAGE_firstboot=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_fwtool=y
CONFIG_PACKAGE_gpioctl-sysfs=y
CONFIG_PACKAGE_kmod-i2c-core=y
CONFIG_PACKAGE_kmod-i2c-mt65xx=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7916-firmware=y
CONFIG_PACKAGE_kmod-mt7986-firmware=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_uboot-evb-u-boot=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-ssl=y
# not present in repo547
# CONFIG_PACKAGE_luci-mod-network-firmware-upgrade is not set
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_wpad-basic-wolfssl=y
# placeholder
# mini_profile ending
